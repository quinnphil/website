---
const linkedIn = 'https://www.linkedin.com/in/quinnphil/';

const services = [
  {
    number: '01',
    title: 'Reporting & dashboards',
    description: 'Clear, useful reporting that helps people see performance, spot risks and make informed decisions.',
    detail: 'Power BI · SQL · Excel',
  },
  {
    number: '02',
    title: 'Data automation',
    description: 'Replace repetitive manual work with reliable workflows and pipelines that give your team time back.',
    detail: 'Python · Power Automate · Azure',
  },
  {
    number: '03',
    title: 'Business analysis',
    description: 'Turn complex problems and fuzzy requirements into a practical, well-scoped path to delivery.',
    detail: 'Discovery · Requirements · Delivery',
  },
  {
    number: '04',
    title: 'Data, risk & security',
    description: 'Understand how data moves through your organisation, and identify the risks and dependencies along the way.',
    detail: 'Data lineage · IT risk · Architecture',
  },
];

const projects = [
  {
    category: 'REPORTING & FORECASTING',
    title: 'A clearer view of business performance',
    description: 'Built a leadership reporting suite spanning commercial performance, order book pipeline and operations, including target tracking and forecasting.',
    tags: 'Power BI / Azure SQL / DAX',
  },
  {
    category: 'DATA INTEGRATION',
    title: 'Connecting data for subscription reporting',
    description: 'Created an Azure Data Factory pipeline to bring Stripe data into Azure SQL for downstream subscription reporting.',
    tags: 'Azure Data Factory / REST API / SQL',
  },
  {
    category: 'PROCESS AUTOMATION',
    title: 'Making funding return checks easier',
    description: 'Built a tool for an apprenticeship training provider to compare learner records with the annual R14 funding return, helping teams resolve mismatches faster.',
    tags: 'Python / marimo / Excel',
  },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Phil Quinn helps organisations turn data into useful insights, better decisions and practical solutions." />
    <meta name="theme-color" content="#111f24" />
    <title>Phil Quinn | Data Analytics Consultant</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#top" aria-label="PQ Data Analytics, back to top">
          <span class="brand-mark">pq<span>.</span></span>
          <span class="brand-name">DATA<br />ANALYTICS</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="#services">Services</a>
          <a href="#work">Selected work</a>
          <a href="#about">About</a>
        </nav>
        <a class="header-contact" href={linkedIn} target="_blank" rel="noopener noreferrer">Let's talk <span aria-hidden="true">↗</span><span class="sr-only"> (opens LinkedIn in a new tab)</span></a>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow"><span class="status-dot"></span> DATA ANALYTICS CONSULTANCY</p>
            <h1>Better data.<br /><em>Better decisions.</em></h1>
            <p class="hero-intro">I help organisations turn their data into insights that move the business forward.</p>
            <div class="hero-actions">
              <a class="button button-dark" href={linkedIn} target="_blank" rel="noopener noreferrer">Start a conversation <span aria-hidden="true">↗</span><span class="sr-only"> (opens LinkedIn in a new tab)</span></a>
              <a class="text-link" href="#services">Explore services <span aria-hidden="true">↓</span></a>
            </div>
          </div>
          <div class="hero-art" aria-hidden="true">
            <div class="art-top"><span>FROM INFORMATION</span><span>TO INSIGHT ↗</span></div>
            <div class="chart">
              <div class="chart-label">A clearer picture<span>01 / 04</span></div>
              <div class="chart-bars">
                <span style="--height: 31%"></span><span style="--height: 48%"></span><span style="--height: 41%"></span><span style="--height: 64%"></span><span style="--height: 58%"></span><span style="--height: 80%"></span><span style="--height: 100%"></span>
              </div>
              <div class="chart-bottom"><span>DATA</span><span>DECISIONS</span></div>
            </div>
            <div class="art-note"><span class="art-asterisk">✳</span><span>Clarity for the<br />decisions that matter.</span></div>
          </div>
        </div>
        <div class="container hero-footer"><span>INDEPENDENT CONSULTANT · UK</span><span>TECHNICAL THINKING. BUSINESS FOCUS.</span></div>
      </section>

      <section class="intro section" aria-labelledby="intro-title">
        <div class="container intro-grid">
          <p class="eyebrow">THE BIG PICTURE <span class="accent">/</span></p>
          <div>
            <h2 id="intro-title">Data is valuable.<br /><span>Understanding it is everything.</span></h2>
            <p>Good data work is about more than the numbers. It’s about asking the right questions, finding the signal in the noise, and making the answer useful to the people making decisions.</p>
          </div>
        </div>
      </section>

      <section class="services section" id="services" aria-labelledby="services-title">
        <div class="container">
          <div class="section-heading">
            <div><p class="eyebrow">HOW I CAN HELP <span class="accent">/</span></p><h2 id="services-title">From questions<br />to clarity.</h2></div>
            <p>Practical support where business needs and technical challenges meet.</p>
          </div>
          <div class="service-grid">
            {services.map((service) => (
              <article class="service-card">
                <div class="card-top"><span>{service.number}</span><span aria-hidden="true">↗</span></div>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <div class="card-detail">{service.detail}</div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="work section" id="work" aria-labelledby="work-title">
        <div class="container">
          <div class="section-heading">
            <div><p class="eyebrow">SELECTED WORK <span class="accent">/</span></p><h2 id="work-title">Useful work.<br />Real-world impact.</h2></div>
            <p>A few examples of turning data challenges into practical solutions.</p>
          </div>
          <div class="project-list">
            {projects.map((project, index) => (
              <article class="project">
                <span class="project-number">0{index + 1}</span>
                <div class="project-body"><p class="eyebrow">{project.category}</p><h3>{project.title}</h3></div>
                <div class="project-description"><p>{project.description}</p><span>{project.tags}</span></div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="about section" id="about" aria-labelledby="about-title">
        <div class="container about-grid">
          <div><p class="eyebrow">ABOUT PHIL <span class="accent">/</span></p><h2 id="about-title">A bridge between<br /><em>data and decisions.</em></h2></div>
          <div class="about-copy">
            <p class="about-lead">I’m Phil Quinn, an independent data analytics consultant based in the UK.</p>
            <p>My background spans business analysis, product ownership and technical consultancy. I can dig into the detail with technical teams, then sit down with leadership and explain what it means for the business.</p>
            <p>Whether you need a better dashboard, a less manual process or a clearer understanding of your data, I bring a practical, collaborative approach to the problem.</p>
            <a class="text-link" href={linkedIn} target="_blank" rel="noopener noreferrer">More about me on LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </div>
      </section>

      <section class="contact section" aria-labelledby="contact-title">
        <div class="container contact-inner">
          <div><p class="eyebrow">LET'S MAKE SENSE OF IT <span class="accent">/</span></p><h2 id="contact-title">Have a data challenge<br /><em>in mind?</em></h2></div>
          <div class="contact-copy"><p>Looking for freelance support or hiring for a data analytics or BI role? I’d be happy to talk.</p><a class="button button-light" href={linkedIn} target="_blank" rel="noopener noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div>
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <div class="container footer-inner"><a class="brand footer-brand" href="#top"><span class="brand-mark">pq<span>.</span></span><span class="brand-name">DATA<br />ANALYTICS</span></a><p>© {new Date().getFullYear()} Phil Quinn. All rights reserved.</p><a href={linkedIn} target="_blank" rel="noopener noreferrer">LinkedIn ↗<span class="sr-only"> (opens in a new tab)</span></a></div>
    </footer>
  </body>
</html>

<style is:global>
  :root{font-family:Arial,Helvetica,sans-serif;color:#17272b;background:#f7f7f2;font-synthesis:none;scroll-behavior:smooth}
  *{box-sizing:border-box}
  body{margin:0}
  a{color:inherit}
  a:focus-visible{outline:3px solid #d9903c;outline-offset:4px}
  .skip-link{position:absolute;z-index:10;left:1rem;top:-5rem;background:#fff;padding:.8rem}
  .skip-link:focus{top:1rem}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .container{width:min(1200px,calc(100% - 96px));margin-inline:auto}
  .site-header{background:#f7f7f2;border-bottom:1px solid #dfe4df}
  .header-inner{height:88px;display:flex;align-items:center;justify-content:space-between;gap:24px}
  .brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none}
  .brand-mark{font-size:35px;font-weight:800;letter-spacing:-3px;line-height:1}.brand-mark span{color:#d79045}
  .brand-name{font-size:9px;line-height:1.2;font-weight:800;letter-spacing:1.2px}
  nav{display:flex;gap:36px;margin-left:auto;margin-right:45px}
  nav a,.header-contact{font-size:13px;font-weight:700;text-decoration:none}
  nav a:hover,.text-link:hover,.site-footer a:hover{text-decoration:underline;text-underline-offset:5px}
  .header-contact{border:1px solid #b7c3bd;padding:13px 18px}.header-contact span[aria-hidden]{margin-left:20px}
  .hero{background:#eef1e9}.hero-grid{min-height:570px;display:grid;grid-template-columns:1.1fr .9fr;gap:70px;align-items:center;padding-top:68px;padding-bottom:70px}
  .eyebrow{font-size:10px;letter-spacing:1.8px;font-weight:800;line-height:1.5;margin:0 0 25px}.status-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#c88038;margin-right:8px;vertical-align:1px}.accent{color:#d18b3f}
  h1,h2,h3,p{margin-top:0}h1,h2{font-family:Georgia,'Times New Roman',serif;font-weight:400;letter-spacing:-.045em}h1{font-size:clamp(54px,6.1vw,86px);line-height:1.04;margin-bottom:27px}h1 em,h2 em{font-weight:400;color:#608579}h1 em,h2 em{font-style:italic}
  .hero-intro{font-size:18px;line-height:1.7;color:#526361;max-width:480px;margin-bottom:33px}.hero-actions{display:flex;align-items:center;gap:30px;flex-wrap:wrap}
  .button{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;padding:17px 19px;font-size:13px;font-weight:700;text-decoration:none;transition:background .2s}.button-dark{background:#192d2e;color:#fff}.button-dark:hover{background:#375b53}.text-link{font-size:13px;font-weight:700;text-decoration:none}.text-link span[aria-hidden]{margin-left:10px}
  .hero-art{background:#dce7dc;min-height:385px;padding:27px 30px;position:relative;display:flex;flex-direction:column;justify-content:space-between}.art-top,.chart-bottom{display:flex;justify-content:space-between;font-size:9px;font-weight:700;letter-spacing:1.2px;color:#57746a}.chart{background:#f6f8f2;width:76%;align-self:center;padding:20px 21px 16px;box-shadow:0 18px 40px #355d4d1a}.chart-label{font-family:Georgia,serif;font-size:16px;display:flex;justify-content:space-between}.chart-label span{font:700 9px Arial,sans-serif;color:#91a99d}.chart-bars{height:125px;display:flex;align-items:end;gap:8px;border-bottom:1px solid #c8d6ca;margin:22px 0 13px}.chart-bars span{height:var(--height);flex:1;background:#a9c5b3}.chart-bars span:nth-last-child(-n+2){background:#618b76}.chart-bottom{font-size:8px}.art-note{display:flex;gap:9px;align-items:center;font-size:10px;line-height:1.4;font-weight:700;color:#57746a}.art-asterisk{font-size:28px;color:#c78742}
  .hero-footer{display:flex;justify-content:space-between;border-top:1px solid #d2dcd2;padding-top:18px;padding-bottom:20px;font-size:9px;letter-spacing:1.2px;font-weight:700;color:#718079}
  .section{padding:105px 0}.intro{background:#fff}.intro-grid,.about-grid{display:grid;grid-template-columns:1fr 2fr;gap:40px}.intro h2,.section-heading h2,.about h2,.contact h2{font-size:clamp(38px,4.2vw,57px);line-height:1.12;margin-bottom:24px}.intro h2 span{color:#82958b}.intro p:not(.eyebrow){color:#647370;line-height:1.8;max-width:650px;font-size:16px;margin-bottom:0}
  .services{background:#f7f7f2}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-bottom:47px}.section-heading h2{margin-bottom:0}.section-heading>p{max-width:270px;line-height:1.7;color:#687873;font-size:14px;margin-bottom:4px}.service-grid{display:grid;grid-template-columns:repeat(4,1fr);border-left:1px solid #dce3db}.service-card{padding:25px 22px 22px;border:1px solid #dce3db;border-left:0;background:#fff;display:flex;flex-direction:column;min-height:300px}.card-top{display:flex;justify-content:space-between;font-size:11px;color:#8aa095;margin-bottom:50px}.card-top span:last-child{font-size:17px;color:#568372}.service-card h3{font-family:Georgia,serif;font-size:21px;font-weight:400;letter-spacing:-.02em;margin-bottom:15px}.service-card p{font-size:13px;color:#657570;line-height:1.7;margin-bottom:25px}.card-detail{border-top:1px solid #e6ebe4;padding-top:16px;margin-top:auto;font-size:10px;font-weight:700;color:#789083;line-height:1.5}
  .work{background:#e8eee7}.project{display:grid;grid-template-columns:55px 1fr 1fr;gap:30px;padding:30px 0;border-top:1px solid #cdd9ce}.project:last-child{border-bottom:1px solid #cdd9ce}.project-number{font-size:11px;color:#82948a}.project .eyebrow{color:#738c7c;margin-bottom:14px;font-size:9px}.project h3{font:400 25px/1.2 Georgia,serif;letter-spacing:-.03em;margin:0}.project-description p{font-size:14px;line-height:1.7;color:#5e7069;margin-bottom:14px}.project-description span{font-size:10px;font-weight:700;color:#6b8a78}
  .about{background:#fff}.about-grid{grid-template-columns:1fr 1fr;gap:70px}.about-copy{max-width:540px}.about-copy p{font-size:15px;line-height:1.8;color:#60716c}.about-copy .about-lead{font-family:Georgia,serif;font-size:23px;line-height:1.4;color:#17272b}.about-copy .text-link{display:inline-block;margin-top:12px}
  .contact{background:#192e2d;color:#f6f8f2}.contact-inner{display:flex;justify-content:space-between;gap:50px;align-items:end}.contact h2{margin-bottom:0}.contact h2 em{color:#a7c7b1}.contact-copy{max-width:330px}.contact-copy p{line-height:1.7;font-size:14px;color:#cad8cf}.button-light{background:#dbe9d8;color:#1c342c}.button-light:hover{background:#fff}
  .site-footer{background:#142522;color:#e3ebe5}.footer-inner{min-height:96px;display:flex;align-items:center;justify-content:space-between;gap:20px}.footer-inner p,.footer-inner>a:last-child{font-size:11px;color:#b1c2b9;margin:0;text-decoration:none}.footer-brand .brand-mark{font-size:30px}
  @media(max-width:850px){.container{width:min(100% - 48px,1200px)}.hero-grid{gap:35px;grid-template-columns:1fr 1fr}.service-grid{grid-template-columns:repeat(2,1fr)}.service-card:nth-child(n+3){border-top:0}.service-card{min-height:260px}.card-top{margin-bottom:35px}}
  @media(max-width:600px){.header-inner{height:76px}.header-inner nav{gap:14px;margin:0}.header-inner nav a{font-size:11px}.header-contact{display:none}.brand-name{font-size:8px}.brand-mark{font-size:29px}.hero-grid{grid-template-columns:1fr;padding-top:64px;gap:45px;min-height:0}.hero-art{min-height:300px}.hero-footer{gap:15px;font-size:8px}.hero-footer span:last-child{text-align:right}.section{padding:72px 0}.intro-grid,.about-grid{grid-template-columns:1fr;gap:15px}.section-heading{display:block}.section-heading>p{margin-top:20px}.service-grid{grid-template-columns:1fr}.service-card{min-height:0}.service-card:nth-child(n+2){border-top:0}.card-top{margin-bottom:30px}.project{grid-template-columns:25px 1fr;gap:15px}.project-description{grid-column:2}.contact-inner{display:block}.contact-copy{margin-top:28px}.footer-inner{padding:25px 0;flex-wrap:wrap}.footer-inner p{order:3;flex-basis:100%}}
  @media(prefers-reduced-motion:reduce){:root{scroll-behavior:auto}*,*::before,*::after{transition:none!important}}
</style>
