---
import { getCollection } from 'astro:content';

const bookmarks = (await getCollection('bookmarks'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const topics = [...new Set(bookmarks.flatMap(({ data }) => data.tags))]
  .sort((a, b) => a.localeCompare(b));
const home = import.meta.env.BASE_URL;
const linkedIn = 'https://www.linkedin.com/in/quinnphil/';
const github = 'https://github.com/quinnphil';
const booking = 'https://cal.com/philquinn';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A collection of technical resources and interesting links curated by Phil Quinn." />
    <meta name="theme-color" content="#050419" />
    <title>Bookmarks | Phil Quinn</title>
    <link rel="icon" type="image/svg+xml" href={`${home}favicon.svg`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={home} aria-label="PQ Data Analytics, home">
          <span class="brand-mark">pq<span>.</span></span>
          <span class="brand-name">DATA<br />ANALYTICS</span>
        </a>
        <nav aria-label="Main navigation">
          <a href={home}>Home</a>
          <a href={`${home}#services`}>Services</a>
          <a href={`${home}#work`}>Selected work</a>
          <a href={`${home}#about`}>About</a>
          <a href={`${home}bookmarks/`} aria-current="page">Bookmarks</a>
        </nav>
        <a class="header-contact" href={booking} target="_blank" rel="noopener noreferrer">Book a call <span aria-hidden="true">↗</span><span class="sr-only"> (opens Cal.com in a new tab)</span></a>
      </div>
    </header>
    <main id="main">
      <section class="page-intro">
        <div class="container">
          <p class="eyebrow">A COLLECTION OF USEFUL LINKS <span>/</span></p>
          <h1>Worth <em>bookmarking.</em></h1>
          <p>Technical resources, ideas and tools I’ve found interesting, collected in one place.</p>
        </div>
      </section>
      <section class="collection" aria-labelledby="collection-title">
        <div class="container">
          <div class="collection-heading">
            <div><p class="eyebrow">THE COLLECTION <span>/</span></p><h2 id="collection-title">Explore the links.</h2></div>
            <p>{bookmarks.length} {bookmarks.length === 1 ? 'bookmark' : 'bookmarks'}</p>
          </div>
          {bookmarks.length === 0 ? (
            <p class="empty">No bookmarks yet. Check back soon.</p>
          ) : (
            <>
              {topics.length > 0 && (
                <div class="filters" hidden aria-label="Filter bookmarks by topic">
                  <span>TOPICS</span>
                  <button type="button" data-topic="" aria-pressed="true">All</button>
                  {topics.map((topic) => <button type="button" data-topic={topic} aria-pressed="false">{topic}</button>)}
                </div>
              )}
              <p class="filter-status sr-only" aria-live="polite"></p>
              <div class="bookmark-list">
                {bookmarks.map(({ data }) => (
                  <article class="bookmark" data-tags={JSON.stringify(data.tags)}>
                    <div class="bookmark-main">
                      <h3><a href={data.url} target="_blank" rel="noopener noreferrer">{data.title} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></h3>
                      {data.comment && <p>{data.comment}</p>}
                    </div>
                    {data.tags.length > 0 && <ul aria-label="Topics">{data.tags.map((tag) => <li>{tag}</li>)}</ul>}
                  </article>
                ))}
              </div>
            </>
          )}
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="brand footer-brand" href={home} aria-label="PQ Data Analytics, home"><span class="brand-mark">pq<span>.</span></span><span class="brand-name">DATA<br />ANALYTICS</span></a>
        <p>© {new Date().getFullYear()} Phil Quinn. All rights reserved.</p>
        <a href={linkedIn} target="_blank" rel="noopener noreferrer">LinkedIn ↗<span class="sr-only"> (opens in a new tab)</span></a>
        <a href={github} target="_blank" rel="noopener noreferrer">GitHub ↗<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </footer>
    <script>
      const filters = document.querySelector<HTMLElement>('.filters');
      if (filters) {
        const buttons = filters.querySelectorAll<HTMLButtonElement>('button[data-topic]');
        const cards = document.querySelectorAll<HTMLElement>('.bookmark[data-tags]');
        const status = document.querySelector<HTMLElement>('.filter-status');
        filters.hidden = false;
        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const topic = button.dataset.topic ?? '';
            let visible = 0;
            cards.forEach((card) => {
              const tags: string[] = JSON.parse(card.dataset.tags ?? '[]');
              card.hidden = topic !== '' && !tags.includes(topic);
              if (!card.hidden) visible++;
            });
            buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
            if (status) status.textContent = `${visible} ${visible === 1 ? 'bookmark' : 'bookmarks'} shown${topic ? ` for ${topic}` : ''}.`;
          });
        });
      }
    </script>
  </body>
</html>

<style>
  :global(:root) {
    font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
    color: #eeeeF4;
    background: #050419;
    font-synthesis: none;
    scroll-behavior: smooth;
    scroll-padding-top: 100px;
    color-scheme: dark;
    --bg: #050419;
    --surface: #0e0d27;
    --accent: #dcfd35;
    --ink: #eeeeF4;
    --muted: #aaa9bb;
    --line: rgb(255 255 255 / 18%);
  }
  :global(*) { box-sizing: border-box; }
  :global(body) { min-height: 100vh; margin: 0; color: var(--ink); background: var(--bg); }
  :global(a) { color: inherit; }
  :global(a:focus-visible), :global(button:focus-visible) { outline: 2px solid var(--accent); outline-offset: 4px; }
  :global(::selection) { color: var(--bg); background: var(--accent); }
  [hidden] { display: none !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .skip-link { position: absolute; z-index: 20; left: 1rem; top: -5rem; padding: .8rem 1rem; color: var(--bg); background: var(--accent); }
  .skip-link:focus { top: 1rem; }
  .container { width: min(1200px, 90%); margin-inline: auto; }
  .site-header { position: sticky; z-index: 10; top: 0; background: rgb(5 4 25 / 88%); border-bottom: 1px solid var(--line); backdrop-filter: blur(16px); }
  .header-inner { min-height: 88px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; flex: none; text-decoration: none; }
  .brand-mark { font-size: 35px; font-weight: 800; letter-spacing: -3px; line-height: 1; }
  .brand-mark span { color: var(--accent); }
  .brand-name { color: var(--muted); font-size: 9px; font-weight: 700; line-height: 1.2; letter-spacing: 1.5px; }
  nav { display: flex; justify-content: flex-end; gap: 20px 30px; margin-left: auto; margin-right: 28px; }
  nav a, .header-contact { font-size: 13px; font-weight: 600; text-decoration: none; }
  nav a { color: #d3d2de; transition: color .2s; }
  nav a:hover, nav a[aria-current="page"] { color: var(--accent); }
  .header-contact { display: inline-flex; align-items: center; gap: 20px; flex: none; padding: 13px 17px; border-radius: 8px; color: var(--bg); background: var(--accent); transition: transform .2s, background-color .2s; }
  .header-contact:hover { transform: translateY(-2px); background: #e8ff72; }
  .page-intro { padding: 100px 0 105px; background: radial-gradient(ellipse at 75% 40%, #171333 0, var(--bg) 55%); }
  .eyebrow { margin: 0 0 25px; color: var(--muted); font-size: 10px; font-weight: 700; line-height: 1.5; letter-spacing: 1.8px; }
  .eyebrow span { color: var(--accent); }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2 { font-weight: 400; letter-spacing: -.055em; }
  h1 { margin-bottom: 25px; font-size: clamp(58px, 7.1vw, 88px); line-height: .99; }
  h1 em { color: var(--accent); font-style: normal; font-weight: 400; }
  .page-intro > div > p:last-child { max-width: 570px; margin-bottom: 0; color: #c4c3d0; font-size: 17px; line-height: 1.7; }
  .collection { min-height: 400px; padding: 85px 0 110px; background: #0a0922; }
  .collection-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 38px; }
  .collection-heading h2 { margin-bottom: 0; font-size: clamp(36px, 4vw, 50px); }
  .collection-heading > p { margin: 0 0 4px; color: var(--muted); font-size: 13px; }
  .filters { display: flex; align-items: center; flex-wrap: wrap; gap: 9px; margin-bottom: 32px; }
  .filters > span { margin-right: 8px; color: var(--muted); font-size: 10px; font-weight: 700; letter-spacing: 1.2px; }
  .filters button { padding: 9px 13px; border: 1px solid rgb(255 255 255 / 24%); border-radius: 999px; color: #d3d2de; background: transparent; font: 600 12px/1.2 "Avenir Next", Avenir, "Segoe UI", sans-serif; cursor: pointer; transition: color .2s, background-color .2s, border-color .2s; }
  .filters button:hover { border-color: var(--accent); color: var(--accent); }
  .filters button[aria-pressed="true"] { border-color: var(--accent); color: var(--bg); background: var(--accent); }
  .bookmark { display: flex; justify-content: space-between; gap: 24px; padding: 27px 0; border-top: 1px solid var(--line); }
  .bookmark:last-child { border-bottom: 1px solid var(--line); }
  .bookmark-main { max-width: 720px; }
  .bookmark h3 { margin: 0; font-size: 23px; font-weight: 400; letter-spacing: -.035em; }
  .bookmark h3 a { text-decoration: none; }
  .bookmark h3 a:hover { color: var(--accent); }
  .bookmark h3 a span[aria-hidden] { margin-left: 5px; color: var(--accent); font-size: 16px; }
  .bookmark p, .empty { margin: 12px 0 0; color: #b9b8c8; font-size: 14px; line-height: 1.7; }
  .bookmark ul { display: flex; justify-content: flex-end; align-content: flex-start; flex-wrap: wrap; gap: 8px; margin: 3px 0 0; padding: 0; list-style: none; }
  .bookmark li { padding: 7px 10px; border: 1px solid rgb(220 253 53 / 24%); border-radius: 999px; color: #d2e98a; background: rgb(220 253 53 / 7%); font-size: 10px; font-weight: 600; }
  .site-footer { color: #e3e2ec; background: #030313; }
  .footer-inner { min-height: 96px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .footer-inner p, .footer-inner > a:not(.footer-brand) { margin: 0; color: #aaa9bb; font-size: 11px; text-decoration: none; }
  .footer-inner > a:not(.footer-brand):hover { color: var(--accent); }
  .footer-brand .brand-mark { font-size: 30px; }
  @media (prefers-reduced-motion: no-preference) {
    .page-intro .container { animation: rise-in .8s both; }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .bookmark { animation: bookmark-rise linear both; animation-timeline: view(); animation-range: entry 0% entry 25%; }
    }
  }
  @keyframes rise-in { from { opacity: .01; transform: translateY(20px); } }
  @keyframes bookmark-rise { from { opacity: .35; translate: 0 16px; } to { opacity: 1; translate: 0 0; } }
  @media (max-width: 850px) {
    .header-inner { gap: 12px; }
    nav { gap: 16px; margin-right: 12px; }
  }
  @media (max-width: 600px) {
    .header-inner { min-height: 76px; gap: 14px; padding: 13px 0; }
    nav { justify-content: flex-end; flex-wrap: wrap; gap: 9px 14px; margin: 0; }
    nav a { font-size: 11px; }
    .header-contact { display: none; }
    .brand-mark { font-size: 29px; }
    .brand-name { font-size: 8px; }
    .page-intro { padding: 68px 0 72px; }
    h1 { font-size: clamp(52px, 12vw, 72px); }
    .collection { padding: 68px 0 80px; }
    .collection-heading { align-items: start; }
    .collection-heading > p { text-align: right; }
    .bookmark { display: block; }
    .bookmark ul { justify-content: flex-start; margin-top: 18px; }
    .footer-inner { padding: 25px 0; flex-wrap: wrap; }
    .footer-inner p { order: 3; flex-basis: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(:root) { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  }
</style>
