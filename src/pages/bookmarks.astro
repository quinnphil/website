---
import { getCollection } from 'astro:content';

const bookmarks = (await getCollection('bookmarks'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const topics = [...new Set(bookmarks.flatMap(({ data }) => data.tags))]
  .sort((a, b) => a.localeCompare(b));
const home = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A collection of technical resources and interesting links curated by Phil Quinn." />
    <meta name="theme-color" content="#111f24" />
    <title>Bookmarks | Phil Quinn</title>
    <link rel="icon" type="image/svg+xml" href={`${home}favicon.svg`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <div class="container header-inner">
        <a class="brand" href={home} aria-label="PQ Data Analytics, home">
          <span class="brand-mark">pq<span>.</span></span>
          <span class="brand-name">DATA<br />ANALYTICS</span>
        </a>
        <nav aria-label="Main navigation">
          <a href={home}>Home</a>
          <a href={`${home}#services`}>Services</a>
          <a href={`${home}#work`}>Selected work</a>
          <a href={`${home}#about`}>About</a>
          <a href={`${home}bookmarks/`} aria-current="page">Bookmarks</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <section class="page-intro">
        <div class="container">
          <p class="eyebrow">A COLLECTION OF USEFUL LINKS <span>/</span></p>
          <h1>Worth <em>bookmarking.</em></h1>
          <p>Technical resources, ideas and tools I’ve found interesting, collected in one place.</p>
        </div>
      </section>
      <section class="collection" aria-labelledby="collection-title">
        <div class="container">
          <div class="collection-heading">
            <div><p class="eyebrow">THE COLLECTION <span>/</span></p><h2 id="collection-title">Explore the links.</h2></div>
            <p>{bookmarks.length} {bookmarks.length === 1 ? 'bookmark' : 'bookmarks'}</p>
          </div>
          {bookmarks.length === 0 ? (
            <p class="empty">No bookmarks yet. Check back soon.</p>
          ) : (
            <>
              {topics.length > 0 && (
                <div class="filters" hidden aria-label="Filter bookmarks by topic">
                  <span>TOPICS</span>
                  <button type="button" data-topic="" aria-pressed="true">All</button>
                  {topics.map((topic) => <button type="button" data-topic={topic} aria-pressed="false">{topic}</button>)}
                </div>
              )}
              <p class="filter-status sr-only" aria-live="polite"></p>
              <div class="bookmark-list">
                {bookmarks.map(({ data }) => (
                  <article class="bookmark" data-tags={JSON.stringify(data.tags)}>
                    <div class="bookmark-main">
                      <h3><a href={data.url} target="_blank" rel="noopener noreferrer">{data.title} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></h3>
                      {data.comment && <p>{data.comment}</p>}
                    </div>
                    {data.tags.length > 0 && <ul aria-label="Topics">{data.tags.map((tag) => <li>{tag}</li>)}</ul>}
                  </article>
                ))}
              </div>
            </>
          )}
        </div>
      </section>
    </main>
    <footer><div class="container footer-inner"><a href={home}>← Back to home</a><p>© {new Date().getFullYear()} Phil Quinn. All rights reserved.</p></div></footer>
    <script>
      const filters = document.querySelector<HTMLElement>('.filters');
      if (filters) {
        const buttons = filters.querySelectorAll<HTMLButtonElement>('button[data-topic]');
        const cards = document.querySelectorAll<HTMLElement>('.bookmark[data-tags]');
        const status = document.querySelector<HTMLElement>('.filter-status');
        filters.hidden = false;
        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const topic = button.dataset.topic ?? '';
            let visible = 0;
            cards.forEach((card) => {
              const tags: string[] = JSON.parse(card.dataset.tags ?? '[]');
              card.hidden = topic !== '' && !tags.includes(topic);
              if (!card.hidden) visible++;
            });
            buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
            if (status) status.textContent = `${visible} ${visible === 1 ? 'bookmark' : 'bookmarks'} shown${topic ? ` for ${topic}` : ''}.`;
          });
        });
      }
    </script>
  </body>
</html>

<style>
  :global(*){box-sizing:border-box}
  :global(body){margin:0;font-family:Arial,Helvetica,sans-serif;color:#17272b;background:#f7f7f2}
  :global(a){color:inherit}
  :global(a:focus-visible),:global(button:focus-visible){outline:3px solid #d9903c;outline-offset:4px}
  [hidden]{display:none!important}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .skip-link{position:absolute;z-index:10;left:1rem;top:-5rem;background:#fff;padding:.8rem}
  .skip-link:focus{top:1rem}
  .container{width:min(1200px,calc(100% - 96px));margin-inline:auto}
  header{background:#f7f7f2;border-bottom:1px solid #dfe4df}
  .header-inner{min-height:88px;display:flex;align-items:center;justify-content:space-between;gap:24px}
  .brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none}
  .brand-mark{font-size:35px;font-weight:800;letter-spacing:-3px;line-height:1}.brand-mark span{color:#d79045}
  .brand-name{font-size:9px;line-height:1.2;font-weight:800;letter-spacing:1.2px}
  nav{display:flex;justify-content:flex-end;flex-wrap:wrap;gap:20px 30px}
  nav a{font-size:13px;font-weight:700;text-decoration:none}
  nav a:hover,nav a[aria-current],footer a:hover{text-decoration:underline;text-underline-offset:5px}
  .page-intro{background:#eef1e9;padding:95px 0}
  .eyebrow{font-size:10px;letter-spacing:1.8px;font-weight:800;line-height:1.5;margin:0 0 25px}.eyebrow span{color:#d18b3f}
  h1,h2,h3,p{margin-top:0}
  h1,h2{font-family:Georgia,'Times New Roman',serif;font-weight:400;letter-spacing:-.045em}
  h1{font-size:clamp(48px,6.1vw,80px);line-height:1.04;margin-bottom:25px}h1 em{font-weight:400;color:#608579}
  .page-intro>div>p:last-child{font-size:17px;line-height:1.7;color:#526361;max-width:570px;margin-bottom:0}
  .collection{padding:90px 0 110px;min-height:350px}.collection-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:38px}.collection-heading h2{font-size:clamp(36px,4vw,50px);margin-bottom:0}.collection-heading>p{font-size:13px;color:#687873;margin:0}
  .filters{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:32px}.filters span{font-size:10px;font-weight:700;letter-spacing:1.2px;color:#687873;margin-right:8px}.filters button{font:700 12px Arial,sans-serif;color:#3b6253;background:transparent;border:1px solid #c7d7ca;padding:9px 13px;cursor:pointer}.filters button:hover,.filters button[aria-pressed="true"]{background:#192e2d;border-color:#192e2d;color:white}
  .bookmark{display:flex;justify-content:space-between;gap:24px;padding:28px 0;border-top:1px solid #d4dfd5}.bookmark:last-child{border-bottom:1px solid #d4dfd5}.bookmark-main{max-width:720px}.bookmark h3{font:400 25px/1.3 Georgia,serif;letter-spacing:-.02em;margin:0}.bookmark h3 a{text-decoration:none}.bookmark h3 a:hover{text-decoration:underline;text-underline-offset:4px}.bookmark h3 a span[aria-hidden]{font:18px Arial,sans-serif;color:#608579;margin-left:5px}.bookmark p,.empty{font-size:14px;line-height:1.7;color:#60716c;margin:12px 0 0}.bookmark ul{display:flex;justify-content:flex-end;align-content:flex-start;flex-wrap:wrap;gap:8px;list-style:none;padding:0;margin:3px 0 0}.bookmark li{font-size:11px;font-weight:700;color:#527666;background:#e6eee6;padding:7px 10px}
  footer{background:#142522;color:#e3ebe5}.footer-inner{min-height:96px;display:flex;align-items:center;justify-content:space-between;gap:20px}.footer-inner a,.footer-inner p{font-size:11px;color:#b1c2b9;margin:0}.footer-inner a{text-decoration:none}
  @media(max-width:850px){.container{width:min(100% - 48px,1200px)}}
  @media(max-width:600px){.header-inner{min-height:76px;padding:15px 0;gap:16px}.brand-mark{font-size:29px}.brand-name{font-size:8px}nav{gap:10px 14px}nav a{font-size:11px}.page-intro{padding:65px 0}.collection{padding:65px 0 80px}.bookmark{display:block}.bookmark ul{justify-content:flex-start;margin-top:18px}.footer-inner{padding:25px 0;flex-wrap:wrap}.footer-inner p{flex-basis:100%}}
</style>
